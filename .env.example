# Copy to .env.local (gitignored). Placeholders only — never commit a real value.

# Server
PORT=3000
# Loopback by default (no authentication yet); 0.0.0.0 only behind a reverse proxy or in Docker.
HOST=127.0.0.1
LOG_LEVEL=info

# Storage
DATABASE_PATH=data/popcorno.sqlite
# Every library root must be this folder or live under it.
MEDIA_ROOT=media
TRANSCODE_CACHE=data/transcode

# Metadata provider — free key from https://www.themoviedb.org/settings/api (v3 key or v4
# read token). Leave the placeholder to run without metadata enrichment.
TMDB_API_KEY=your-tmdb-api-key
# Language of titles and synopses (TMDB `language` parameter).
TMDB_LANGUAGE=en-US
# Cached posters / backdrops, served by GET /artwork/:file.
ARTWORK_DIR=data/artwork

# Path to the FFmpeg binaries (defaults to the ones on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
