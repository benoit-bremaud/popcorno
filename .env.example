# Copy to .env.local (gitignored). Placeholders only — never commit a real value.

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage
DATABASE_PATH=data/popcorno.sqlite
MEDIA_ROOT=media
TRANSCODE_CACHE=data/transcode

# Metadata provider — free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Path to the FFmpeg binaries (defaults to the ones on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
